import { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";
import API from "../api/ticketApi";
import "../styles/CreateTicket.css";

function CreateTicket() {
    const navigate = useNavigate();

    const [ticket, setTicket] = useState({
        ticket_title: "",
        category: "Software",
        priority: "Low",
        description: "",
        assigned_to: "",
        department: "IT Support"
    });


        const fetchAgents = async () => {
            try {
                const response = await API.get("/users/agents");
                setAgents(response.data.agents || []);
            } catch (error) {
                console.error(
                    "Failed to load support agents:",
                    error
                );
            }
        };

        fetchAgents();
    }, []);

    useEffect(() => {
        if (!success) return;

        const redirectTimer = setTimeout(() => {
            navigate("/dashboard");
        }, 5000);

        const countdownTimer = setInterval(() => {
            setCountdown((previous) => {
                if (previous <= 1) {
                    clearInterval(countdownTimer);
                    return 0;
                }

                return previous - 1;
            });
        }, 1000);

        return () => {
            clearTimeout(redirectTimer);
            clearInterval(countdownTimer);
        };
    }, [success, navigate]);

    const handleChange = (e) => {
        setTicket({
            ...ticket,
            [e.target.name]: e.target.value
        });
    };

    const handleSubmit = async (e) => {
        e.preventDefault();

        try {
            const response = await API.post(
                "/tickets/create",
                {
                    ...ticket,
                    assigned_to: ticket.assigned_to
                        ? Number(ticket.assigned_to)
                        : null
                }
            );

const newTicketId = response.data.ticket_id || null;

            setCreatedTicketId(newTicketId);
            setSuccess(true);

            setTicket({
                ticket_title: "",
                category: "Software",
                priority: "Low",
                description: "",
                assigned_to: "",
                department: "IT Support"
            });

        } catch (error) {
            console.error("Create Ticket Error:", error);

            alert(
                error.response?.data?.message ||
                "Failed to create ticket."
            );
        }
    };

    if (success) {
        return (
            <div className="create-ticket success-container">

                <div className="success-icon">
                    ✓
                </div>

                <h1>Ticket Created Successfully</h1>

                <p className="success-message">
                    Your support ticket has been submitted successfully.
                </p>

                {createdTicketId && (
                    <p className="ticket-id-message">
                        Ticket ID: <strong>#{createdTicketId}</strong>
                    </p>
                )}

                <p className="support-message">
                    Our customer support team will review your request
                    and contact you via email within <strong>3–5 working days</strong>.
                </p>

                <p className="redirect-message">
                    Redirecting to Dashboard in{" "}
                    <strong>{countdown}</strong> seconds...
                </p>

                <button
                    className="success-dashboard-button"
                    onClick={() => navigate("/dashboard")}
                >
                    Go to Dashboard Now
                </button>

            </div>
        );
    }

    return (
        <div className="create-ticket">

            <h1>Create Ticket</h1>

            <form onSubmit={handleSubmit}>

                <label>Ticket Title</label>

                <input
                    type="text"
                    name="ticket_title"
                    value={ticket.ticket_title}
                    onChange={handleChange}
                    placeholder="Enter Ticket Title"
                    required
                />

                <label>Category</label>

                <select
                    name="category"
                    value={ticket.category}
                    onChange={handleChange}
                >
                    <option>Software</option>
                    <option>Hardware</option>
                    <option>Network</option>
                    <option>Other</option>
                </select>

                <label>Priority</label>

                <select
                    name="priority"
                    value={ticket.priority}
                    onChange={handleChange}
                >
                    <option>Low</option>
                    <option>Medium</option>
                    <option>High</option>
                    <option>Critical</option>
                </select>

                <label>Department</label>

                <select
                    name="department"
                    value={ticket.department}
                    onChange={handleChange}
                >
                    <option>IT Support</option>
                    <option>HR</option>
                    <option>Finance</option>
                    <option>Administration</option>
                    <option>Network</option>
                </select>

                <label>Assign To</label>

                <select
                    name="assigned_to"
                    value={ticket.assigned_to}
                    onChange={handleChange}
                >
                    <option value="">
                        Select Support Employee
                    </option>

                    {agents.map((agent) => (
                        <option
                            key={agent.id}
                            value={agent.id}
                        >
                            {agent.full_name}
                        </option>
                    ))}
                </select>

                <label>Description</label>

                <textarea
                    rows="6"
                    name="description"
                    value={ticket.description}
                    onChange={handleChange}
                    placeholder="Describe your issue..."
                />

                <button type="submit">
                    Create Ticket
                </button>

            </form>

        </div>
    );
}

export default CreateTicket;
