import React, { useEffect, useState } from "react";
import { useSearchParams } from "react-router-dom";
import API from "../api/ticketApi";
import "./ViewTicket.css";

function ViewTicket() {
    const [tickets, setTickets] = useState([]);
    const [agents, setAgents] = useState([]);
    const [selectedTicket, setSelectedTicket] = useState(null);

    const [search, setSearch] = useState("");
    const [statusFilter, setStatusFilter] = useState("All");
    const [priorityFilter, setPriorityFilter] = useState("All");

    const [comments, setComments] = useState([]);
    const [newComment, setNewComment] = useState("");
    const [commentType, setCommentType] = useState("reply");
    const [commentLoading, setCommentLoading] = useState(false);

    const [searchParams] = useSearchParams();

    useEffect(() => {
        const statusFromDashboard = searchParams.get("status");

        if (statusFromDashboard) {
            setStatusFilter(statusFromDashboard);
        } else {
            setStatusFilter("All");
        }

        fetchTickets();
        fetchAgents();
    }, [searchParams]);

    const fetchTickets = async () => {
        try {
            const response = await API.get("/tickets");
            setTickets(response.data.tickets || []);
        } catch (error) {
            console.error("Unable to fetch tickets:", error);
        }
    };

    const fetchAgents = async () => {
        try {
            const response = await API.get("/users/agents");
            setAgents(response.data.agents || []);
        } catch (error) {
            console.error("Unable to fetch agents:", error);
            setAgents([]);
        }
    };

    const fetchComments = async (ticketId) => {
        if (!ticketId) return;

        try {
            setCommentLoading(true);

            const response = await API.get(
                `/comments/ticket/${ticketId}`
            );

            setComments(response.data.comments || []);
        } catch (error) {
            console.error("Unable to fetch comments:", error);
            setComments([]);
        } finally {
            setCommentLoading(false);
        }
    };

    const openTicket = async (ticket) => {
        try {
            const response = await API.get(
                `/tickets/${ticket.id}`
            );

            const fullTicket = response.data.ticket;

            setSelectedTicket(fullTicket);
            setNewComment("");
            setCommentType("reply");

            await fetchComments(ticket.id);
        } catch (error) {
            console.error("Unable to open ticket:", error);

            setSelectedTicket(ticket);
            setNewComment("");
            setCommentType("reply");

            await fetchComments(ticket.id);
        }
    };

    const backToTickets = () => {
        setSelectedTicket(null);
        setComments([]);
        setNewComment("");
        setCommentType("reply");
    };

    const addComment = async () => {
        if (!selectedTicket) return;

        const commentText = newComment.trim();

        if (!commentText) {
            return;
        }

        try {
            setCommentLoading(true);

            await API.post("/comments", {
                ticket_id: selectedTicket.id,
                comment: commentText,
                comment_type: commentType
            });

            setNewComment("");
            setCommentType("reply");

            await fetchComments(selectedTicket.id);
        } catch (error) {
            console.error("Unable to add comment:", error);
        } finally {
            setCommentLoading(false);
        }
    };

    const deleteTicket = async (id) => {
        const confirmed = window.confirm(
            "Are you sure you want to delete this ticket?"
        );

        if (!confirmed) return;

        try {
            await API.delete(`/tickets/${id}`);

            setSelectedTicket(null);
            setComments([]);

            await fetchTickets();
        } catch (error) {
            console.error("Delete failed:", error);
        }
    };

    const updateTicket = async (ticket, changes) => {
        try {
            const updatedTicket = {
                ticket_title: ticket.ticket_title,

                category:
                    changes.category !== undefined
                        ? changes.category
                        : ticket.category,

                priority:
                    changes.priority !== undefined
                        ? changes.priority
                        : ticket.priority,

                description: ticket.description,

                status:
                    changes.status !== undefined
                        ? changes.status
                        : ticket.status,

                assigned_to:
                    changes.assigned_to !== undefined
                        ? changes.assigned_to
                        : ticket.assigned_to,

                department:
                    changes.department !== undefined
                        ? changes.department
                        : ticket.department
            };

            await API.put(
                `/tickets/${ticket.id}`,
                updatedTicket
            );

            const response = await API.get(
                `/tickets/${ticket.id}`
            );

            setSelectedTicket(response.data.ticket);

            await fetchTickets();
        } catch (error) {
            console.error("Update failed:", error);
        }
    };

    const filteredTickets = tickets
        .filter((ticket) =>
            (ticket.ticket_title || "")
                .toLowerCase()
                .includes(search.toLowerCase())
        )
        .filter((ticket) =>
            statusFilter === "All"
                ? true
                : ticket.status === statusFilter
        )
        .filter((ticket) =>
            priorityFilter === "All"
                ? true
                : ticket.priority === priorityFilter
        )
        .sort(
            (a, b) =>
                new Date(b.created_at) -
                new Date(a.created_at)
        );

    const getStatusClass = (status) => {
        return `status-badge status-${(
            status || "Open"
        )
            .toLowerCase()
            .replace(/\s+/g, "-")}`;
    };

    const getPriorityClass = (priority) => {
        return `priority-badge priority-${(
            priority || "Medium"
        ).toLowerCase()}`;
    };

    const getInitials = (name) => {
        if (!name) return "?";

        return name
            .split(" ")
            .filter(Boolean)
            .slice(0, 2)
            .map((part) => part[0])
            .join("")
            .toUpperCase();
    };

    const formatDate = (date) => {
        if (!date) return "N/A";

        const parsedDate = new Date(date);

        if (Number.isNaN(parsedDate.getTime())) {
            return "N/A";
        }

        return parsedDate.toLocaleString([], {
            day: "2-digit",
            month: "short",
            year: "numeric",
            hour: "2-digit",
            minute: "2-digit"
        });
    };

    const formatCommentDate = (date) => {
        if (!date) return "";

        const parsedDate = new Date(date);

        if (Number.isNaN(parsedDate.getTime())) {
            return "";
        }

        return parsedDate.toLocaleString([], {
            day: "2-digit",
            month: "short",
            hour: "2-digit",
            minute: "2-digit"
        });
    };

    /*
     * =========================================================
     * DETAIL VIEW
     * =========================================================
     */

    if (selectedTicket) {
        const creatorName =
            selectedTicket.creator_name ||
            selectedTicket.requester_name ||
            "Unknown User";

        const creatorEmail =
            selectedTicket.creator_email ||
            selectedTicket.requester_email ||
            "No email available";

        const assignedName =
            selectedTicket.assigned_agent_name ||
            null;

        const assignedEmail =
            selectedTicket.assigned_agent_email ||
            null;

        return (
            <div className="ticket-detail-page">

                {/* =================================================
                    TOP BAR
                   ================================================= */}

                <div className="ticket-topbar">

                    <button
                        className="back-button"
                        onClick={backToTickets}
                    >
                        <span>←</span>
                        Back to Tickets
                    </button>

                    <div className="topbar-actions">

                        <button
                            className="secondary-action"
                            onClick={() => window.print()}
                        >
                            Print
                        </button>

                        <button
                            className="danger-action"
                            onClick={() =>
                                deleteTicket(
                                    selectedTicket.id
                                )
                            }
                        >
                            Delete
                        </button>

                    </div>

                </div>


                {/* =================================================
                    TICKET HEADER
                   ================================================= */}

                <div className="ticket-hero">

                    <div className="ticket-hero-content">

                        <div className="ticket-breadcrumb">
                            IT Support
                            <span>›</span>
                            Tickets
                            <span>›</span>
                            #{selectedTicket.id}
                        </div>

                        <div className="ticket-heading-row">

                            <div>

                                <div className="ticket-number-label">
                                    TICKET #{selectedTicket.id}
                                </div>

                                <h1>
                                    {selectedTicket.ticket_title}
                                </h1>

                                <div className="ticket-created-line">
                                    Created by{" "}
                                    <strong>
                                        {creatorName}
                                    </strong>

                                    <span>•</span>

                                    {formatDate(
                                        selectedTicket.created_at
                                    )}
                                </div>

                            </div>

                            <div className="ticket-header-badges">

                                <span
                                    className={getStatusClass(
                                        selectedTicket.status
                                    )}
                                >
                                    <span className="status-dot" />
                                    {selectedTicket.status ||
                                        "Open"}
                                </span>

                                <span
                                    className={getPriorityClass(
                                        selectedTicket.priority
                                    )}
                                >
                                    {selectedTicket.priority ||
                                        "Medium"}
                                </span>

                            </div>

                        </div>

                    </div>

                </div>


                {/* =================================================
                    WORKSPACE
                   ================================================= */}

                <div className="ticket-workspace">

                    {/* =================================================
                        LEFT CONTENT
                       ================================================= */}

                    <main className="ticket-content-column">

                        {/* =================================================
                            DESCRIPTION
                           ================================================= */}

                        <section className="ticket-card">

                            <div className="ticket-card-header">

                                <div>

                                    <h2>
                                        Description
                                    </h2>

                                    <p>
                                        Issue details provided by
                                        the requester
                                    </p>

                                </div>

                            </div>

                            <div className="ticket-card-body">

                                <div className="description-text">
                                    {selectedTicket.description ||
                                        "No description provided."}
                                </div>

                            </div>

                        </section>


                        {/* =================================================
                            PROPERTIES
                           ================================================= */}

                        <section className="ticket-card">

                            <div className="ticket-card-header">

                                <div>

                                    <h2>
                                        Ticket Properties
                                    </h2>

                                    <p>
                                        Manage the current ticket
                                        configuration
                                    </p>

                                </div>

                            </div>

                            <div className="property-grid">

                                <div className="property-field">

                                    <label>
                                        Status
                                    </label>

                                    <select
                                        value={
                                            selectedTicket.status ||
                                            "Open"
                                        }
                                        onChange={(e) =>
                                            updateTicket(
                                                selectedTicket,
                                                {
                                                    status:
                                                        e.target.value
                                                }
                                            )
                                        }
                                    >
                                        <option value="Open">
                                            Open
                                        </option>

                                        <option value="In Progress">
                                            In Progress
                                        </option>

                                        <option value="Resolved">
                                            Resolved
                                        </option>

                                        <option value="Closed">
                                            Closed
                                        </option>
                                    </select>

                                </div>


                                <div className="property-field">

                                    <label>
                                        Priority
                                    </label>

                                    <select
                                        value={
                                            selectedTicket.priority ||
                                            "Medium"
                                        }
                                        onChange={(e) =>
                                            updateTicket(
                                                selectedTicket,
                                                {
                                                    priority:
                                                        e.target.value
                                                }
                                            )
                                        }
                                    >
                                        <option value="Low">
                                            Low
                                        </option>

                                        <option value="Medium">
                                            Medium
                                        </option>

                                        <option value="High">
                                            High
                                        </option>

                                        <option value="Critical">
                                            Critical
                                        </option>
                                    </select>

                                </div>


                                <div className="property-field">

                                    <label>
                                        Category
                                    </label>

                                    <select
                                        value={
                                            selectedTicket.category ||
                                            "Software"
                                        }
                                        onChange={(e) =>
                                            updateTicket(
                                                selectedTicket,
                                                {
                                                    category:
                                                        e.target.value
                                                }
                                            )
                                        }
                                    >
                                        <option value="Software">
                                            Software
                                        </option>

                                        <option value="Hardware">
                                            Hardware
                                        </option>

                                        <option value="Network">
                                            Network
                                        </option>

                                        <option value="Access">
                                            Access
                                        </option>

                                        <option value="Other">
                                            Other
                                        </option>
                                    </select>

                                </div>


                                <div className="property-field">

                                    <label>
                                        Department
                                    </label>

                                    <select
                                        value={
                                            selectedTicket.department ||
                                            ""
                                        }
                                        onChange={(e) =>
                                            updateTicket(
                                                selectedTicket,
                                                {
                                                    department:
                                                        e.target.value
                                                }
                                            )
                                        }
                                    >
                                        <option value="">
                                            Not Assigned
                                        </option>

                                        <option value="IT Support">
                                            IT Support
                                        </option>

                                        <option value="Technical Support">
                                            Technical Support
                                        </option>

                                        <option value="Network">
                                            Network
                                        </option>

                                        <option value="HR">
                                            HR
                                        </option>

                                        <option value="Finance">
                                            Finance
                                        </option>
                                    </select>

                                </div>

                            </div>

                        </section>


                        {/* =================================================
                            CONVERSATION
                           ================================================= */}

                        <section className="ticket-card">

                            <div className="ticket-card-header">

                                <div>

                                    <h2>
                                        Conversation
                                    </h2>

                                    <p>
                                        Communicate with the requester
                                        and document ticket activity
                                    </p>

                                </div>

                                <div
                                    style={{
                                        fontSize: "13px",
                                        fontWeight: 600,
                                        color: "#64748b"
                                    }}
                                >
                                    {comments.length}{" "}
                                    {comments.length === 1
                                        ? "message"
                                        : "messages"}
                                </div>

                            </div>


                            <div
                                style={{
                                    padding: "24px",
                                    background: "#f8fafc"
                                }}
                            >

                                {commentLoading &&
                                comments.length === 0 ? (

                                    <div
                                        style={{
                                            padding: "30px",
                                            textAlign: "center",
                                            color: "#64748b"
                                        }}
                                    >
                                        Loading conversation...
                                    </div>

                                ) : comments.length === 0 ? (

                                    <div
                                        style={{
                                            padding: "35px 20px",
                                            textAlign: "center",
                                            border: "1px dashed #cbd5e1",
                                            borderRadius: "12px",
                                            background: "#ffffff"
                                        }}
                                    >
                                        <div
                                            style={{
                                                fontSize: "30px",
                                                marginBottom: "8px"
                                            }}
                                        >
                                            💬
                                        </div>

                                        <strong
                                            style={{
                                                display: "block",
                                                color: "#1e293b",
                                                marginBottom: "5px"
                                            }}
                                        >
                                            No conversation yet
                                        </strong>

                                        <span
                                            style={{
                                                color: "#64748b",
                                                fontSize: "14px"
                                            }}
                                        >
                                            Start the conversation by
                                            sending a reply below.
                                        </span>
                                    </div>

                                ) : (

                                    <div
                                        style={{
                                            display: "flex",
                                            flexDirection: "column",
                                            gap: "16px"
                                        }}
                                    >

                                        {comments.map(
                                            (comment) => {

                                                const author =
                                                    comment.full_name ||
                                                    "User";

                                                const isInternal =
                                                    comment.comment_type ===
                                                    "internal_note";

                                                return (
                                                    <div
                                                        key={
                                                            comment.id
                                                        }
                                                        style={{
                                                            display: "flex",
                                                            gap: "12px",
                                                            alignItems:
                                                                "flex-start"
                                                        }}
                                                    >

                                                        <div
                                                            style={{
                                                                width: "40px",
                                                                height: "40px",
                                                                minWidth:
                                                                    "40px",
                                                                borderRadius:
                                                                    "50%",
                                                                background:
                                                                    isInternal
                                                                        ? "#fff7ed"
                                                                        : "#e0e7ff",
                                                                color:
                                                                    isInternal
                                                                        ? "#c2410c"
                                                                        : "#4338ca",
                                                                display:
                                                                    "flex",
                                                                alignItems:
                                                                    "center",
                                                                justifyContent:
                                                                    "center",
                                                                fontWeight:
                                                                    700,
                                                                fontSize:
                                                                    "13px"
                                                            }}
                                                        >
                                                            {getInitials(
                                                                author
                                                            )}
                                                        </div>


                                                        <div
                                                            style={{
                                                                flex: 1,
                                                                background:
                                                                    "#ffffff",
                                                                border:
                                                                    isInternal
                                                                        ? "1px solid #fed7aa"
                                                                        : "1px solid #e2e8f0",
                                                                borderRadius:
                                                                    "12px",
                                                                padding:
                                                                    "15px 17px",
                                                                boxShadow:
                                                                    "0 1px 2px rgba(15,23,42,0.04)"
                                                            }}
                                                        >

                                                            <div
                                                                style={{
                                                                    display:
                                                                        "flex",
                                                                    justifyContent:
                                                                        "space-between",
                                                                    alignItems:
                                                                        "center",
                                                                    gap:
                                                                        "12px",
                                                                    marginBottom:
                                                                        "8px"
                                                                }}
                                                            >

                                                                <div
                                                                    style={{
                                                                        display:
                                                                            "flex",
                                                                        alignItems:
                                                                            "center",
                                                                        gap:
                                                                            "8px"
                                                                    }}
                                                                >

                                                                    <strong
                                                                        style={{
                                                                            color:
                                                                                "#1e293b",
                                                                            fontSize:
                                                                                "14px"
                                                                        }}
                                                                    >
                                                                        {
                                                                            author
                                                                        }
                                                                    </strong>

                                                                    {isInternal && (
                                                                        <span
                                                                            style={{
                                                                                background:
                                                                                    "#ffedd5",
                                                                                color:
                                                                                    "#c2410c",
                                                                                borderRadius:
                                                                                    "999px",
                                                                                padding:
                                                                                    "3px 8px",
                                                                                fontSize:
                                                                                    "11px",
                                                                                fontWeight:
                                                                                    700
                                                                            }}
                                                                        >
                                                                            INTERNAL NOTE
                                                                        </span>
                                                                    )}

                                                                </div>

                                                                <span
                                                                    style={{
                                                                        color:
                                                                            "#94a3b8",
                                                                        fontSize:
                                                                            "12px",
                                                                        whiteSpace:
                                                                            "nowrap"
                                                                    }}
                                                                >
                                                                    {formatCommentDate(
                                                                        comment.created_at
                                                                    )}
                                                                </span>

                                                            </div>


                                                            <div
                                                                style={{
                                                                    color:
                                                                        "#475569",
                                                                    fontSize:
                                                                        "14px",
                                                                    lineHeight:
                                                                        1.6,
                                                                    whiteSpace:
                                                                        "pre-wrap"
                                                                }}
                                                            >
                                                                {
                                                                    comment.comment
                                                                }
                                                            </div>

                                                        </div>

                                                    </div>
                                                );
                                            }
                                        )}

                                    </div>

                                )}

                            </div>


                            {/* COMMENT COMPOSER */}

                            <div
                                style={{
                                    borderTop:
                                        "1px solid #e2e8f0",
                                    padding: "20px 24px",
                                    background: "#ffffff"
                                }}
                            >

                                <div
                                    style={{
                                        display: "flex",
                                        gap: "8px",
                                        marginBottom: "10px"
                                    }}
                                >

                                    <button
                                        type="button"
                                        onClick={() =>
                                            setCommentType("reply")
                                        }
                                        style={{
                                            border: "1px solid #cbd5e1",
                                            borderRadius: "8px",
                                            padding: "7px 13px",
                                            background:
                                                commentType ===
                                                "reply"
                                                    ? "#eef2ff"
                                                    : "#ffffff",
                                            color:
                                                commentType ===
                                                "reply"
                                                    ? "#4338ca"
                                                    : "#64748b",
                                            fontWeight: 600,
                                            cursor: "pointer"
                                        }}
                                    >
                                        Reply
                                    </button>

                                    <button
                                        type="button"
                                        onClick={() =>
                                            setCommentType(
                                                "internal_note"
                                            )
                                        }
                                        style={{
                                            border: "1px solid #cbd5e1",
                                            borderRadius: "8px",
                                            padding: "7px 13px",
                                            background:
                                                commentType ===
                                                "internal_note"
                                                    ? "#fff7ed"
                                                    : "#ffffff",
                                            color:
                                                commentType ===
                                                "internal_note"
                                                    ? "#c2410c"
                                                    : "#64748b",
                                            fontWeight: 600,
                                            cursor: "pointer"
                                        }}
                                    >
                                        Internal Note
                                    </button>

                                </div>


                                <textarea
                                    value={newComment}
                                    onChange={(e) =>
                                        setNewComment(
                                            e.target.value
                                        )
                                    }
                                    placeholder={
                                        commentType ===
                                        "internal_note"
                                            ? "Add an internal note for support staff..."
                                            : "Write a reply..."
                                    }
                                    rows="4"
                                    style={{
                                        width: "100%",
                                        boxSizing: "border-box",
                                        resize: "vertical",
                                        border:
                                            "1px solid #cbd5e1",
                                        borderRadius: "10px",
                                        padding: "12px 14px",
                                        fontFamily: "inherit",
                                        fontSize: "14px",
                                        outline: "none",
                                        color: "#1e293b"
                                    }}
                                    onKeyDown={(e) => {
                                        if (
                                            (e.ctrlKey ||
                                                e.metaKey) &&
                                            e.key === "Enter"
                                        ) {
                                            addComment();
                                        }
                                    }}
                                />


                                <div
                                    style={{
                                        display: "flex",
                                        justifyContent:
                                            "space-between",
                                        alignItems: "center",
                                        marginTop: "10px",
                                        gap: "12px"
                                    }}
                                >

                                    <span
                                        style={{
                                            fontSize: "12px",
                                            color: "#94a3b8"
                                        }}
                                    >
                                        Ctrl + Enter to send
                                    </span>

                                    <button
                                        type="button"
                                        onClick={addComment}
                                        disabled={
                                            commentLoading ||
                                            !newComment.trim()
                                        }
                                        style={{
                                            border: "none",
                                            borderRadius: "9px",
                                            padding: "10px 18px",
                                            background:
                                                commentLoading ||
                                                !newComment.trim()
                                                    ? "#cbd5e1"
                                                    : "#4f46e5",
                                            color: "#ffffff",
                                            fontWeight: 700,
                                            cursor:
                                                commentLoading ||
                                                !newComment.trim()
                                                    ? "not-allowed"
                                                    : "pointer"
                                        }}
                                    >
                                        {commentLoading
                                            ? "Sending..."
                                            : "Send Reply"}
                                    </button>

                                </div>

                            </div>

                        </section>


                        {/* =================================================
                            ACTIVITY
                           ================================================= */}

                        <section className="ticket-card">

                            <div className="ticket-card-header">

                                <div>

                                    <h2>
                                        Activity
                                    </h2>

                                    <p>
                                        Ticket history
                                    </p>

                                </div>

                            </div>

                            <div className="activity-list">

                                <div className="activity-item">

                                    <div className="activity-icon">
                                        ✓
                                    </div>

                                    <div className="activity-content">

                                        <strong>
                                            Ticket created
                                        </strong>

                                        <p>
                                            {creatorName} created
                                            this ticket.
                                        </p>

                                        <span>
                                            {formatDate(
                                                selectedTicket.created_at
                                            )}
                                        </span>

                                    </div>

                                </div>


                                <div className="activity-item">

                                    <div className="activity-icon secondary">
                                        →
                                    </div>

                                    <div className="activity-content">

                                        <strong>
                                            Current status
                                        </strong>

                                        <p>
                                            Ticket is currently{" "}
                                            <strong>
                                                {selectedTicket.status ||
                                                    "Open"}
                                            </strong>
                                            .
                                        </p>

                                        <span>
                                            Last updated{" "}
                                            {formatDate(
                                                selectedTicket.updated_at
                                            )}
                                        </span>

                                    </div>

                                </div>

                            </div>

                        </section>

                    </main>


                    {/* =================================================
                        RIGHT SIDEBAR
                       ================================================= */}

                    <aside className="ticket-sidebar">

                        {/* REQUESTER */}

                        <section className="sidebar-card">

                            <div className="sidebar-title">
                                Requester
                            </div>

                            <div className="person-card">

                                <div className="avatar">
                                    {getInitials(
                                        creatorName
                                    )}
                                </div>

                                <div className="person-details">

                                    <strong>
                                        {creatorName}
                                    </strong>

                                    <span>
                                        {creatorEmail}
                                    </span>

                                </div>

                            </div>

                        </section>


                        {/* ASSIGNEE */}

                        <section className="sidebar-card">

                            <div className="sidebar-title">
                                Assigned Agent
                            </div>

                            {assignedName ? (

                                <div className="person-card">

                                    <div className="avatar agent-avatar">
                                        {getInitials(
                                            assignedName
                                        )}
                                    </div>

                                    <div className="person-details">

                                        <strong>
                                            {assignedName}
                                        </strong>

                                        <span>
                                            {assignedEmail ||
                                                "No email available"}
                                        </span>

                                    </div>

                                </div>

                            ) : (

                                <div className="unassigned-state">
                                    No agent assigned
                                </div>

                            )}


                            <div className="assignment-control">

                                <label>
                                    Assign ticket
                                </label>

                                <select
                                    value={
                                        selectedTicket.assigned_to ||
                                        ""
                                    }
                                    onChange={(e) =>
                                        updateTicket(
                                            selectedTicket,
                                            {
                                                assigned_to:
                                                    e.target.value
                                                        ? Number(
                                                            e.target
                                                                .value
                                                        )
                                                        : null
                                            }
                                        )
                                    }
                                >

                                    <option value="">
                                        Unassigned
                                    </option>

                                    {agents.map(
                                        (agent) => (
                                            <option
                                                key={
                                                    agent.id
                                                }
                                                value={
                                                    agent.id
                                                }
                                            >
                                                {
                                                    agent.full_name
                                                }{" "}
                                                —{" "}
                                                {
                                                    agent.email
                                                }
                                            </option>
                                        )
                                    )}

                                </select>

                            </div>

                        </section>


                        {/* DETAILS */}

                        <section className="sidebar-card">

                            <div className="sidebar-title">
                                Ticket Information
                            </div>

                            <div className="detail-list">

                                <div className="detail-row">

                                    <span>
                                        Ticket ID
                                    </span>

                                    <strong>
                                        #{selectedTicket.id}
                                    </strong>

                                </div>


                                <div className="detail-row">

                                    <span>
                                        Category
                                    </span>

                                    <strong>
                                        {selectedTicket.category ||
                                            "General"}
                                    </strong>

                                </div>


                                <div className="detail-row">

                                    <span>
                                        Department
                                    </span>

                                    <strong>
                                        {selectedTicket.department ||
                                            "Not Assigned"}
                                    </strong>

                                </div>


                                <div className="detail-row">

                                    <span>
                                        Priority
                                    </span>

                                    <strong
                                        className={getPriorityClass(
                                            selectedTicket.priority
                                        )}
                                    >
                                        {selectedTicket.priority ||
                                            "Medium"}
                                    </strong>

                                </div>


                                <div className="detail-row">

                                    <span>
                                        Created
                                    </span>

                                    <strong>
                                        {formatDate(
                                            selectedTicket.created_at
                                        )}
                                    </strong>

                                </div>


                                <div className="detail-row">

                                    <span>
                                        Last Updated
                                    </span>

                                    <strong>
                                        {formatDate(
                                            selectedTicket.updated_at
                                        )}
                                    </strong>

                                </div>

                            </div>

                        </section>

                    </aside>

                </div>

            </div>
        );
    }


    /*
     * =========================================================
     * LIST VIEW
     * =========================================================
     */

    return (
        <div className="ticket-list-page">

            <div className="list-header">

                <div>

                    <div className="section-eyebrow">
                        IT SUPPORT
                    </div>

                    <h1>
                        Tickets
                    </h1>

                    <p>
                        Manage and track support requests
                    </p>

                </div>

                <div className="ticket-count">
                    {filteredTickets.length}{" "}
                    {filteredTickets.length === 1
                        ? "Ticket"
                        : "Tickets"}
                </div>

            </div>


            {/* FILTER BAR */}

            <div className="filter-bar">

                <div className="search-wrapper">

                    <span className="search-icon">
                        ⌕
                    </span>

                    <input
                        type="text"
                        placeholder="Search tickets..."
                        value={search}
                        onChange={(e) =>
                            setSearch(e.target.value)
                        }
                    />

                </div>


                <select
                    value={statusFilter}
                    onChange={(e) =>
                        setStatusFilter(e.target.value)
                    }
                >
                    <option value="All">
                        All Status
                    </option>

                    <option value="Open">
                        Open
                    </option>

                    <option value="In Progress">
                        In Progress
                    </option>

                    <option value="Resolved">
                        Resolved
                    </option>

                    <option value="Closed">
                        Closed
                    </option>
                </select>


                <select
                    value={priorityFilter}
                    onChange={(e) =>
                        setPriorityFilter(e.target.value)
                    }
                >
                    <option value="All">
                        All Priority
                    </option>

                    <option value="Low">
                        Low
                    </option>

                    <option value="Medium">
                        Medium
                    </option>

                    <option value="High">
                        High
                    </option>

                    <option value="Critical">
                        Critical
                    </option>
                </select>

            </div>


            {/* TABLE */}

            <div className="ticket-table-card">

                <div className="table-scroll">

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    ID
                                </th>

                                <th>
                                    Subject
                                </th>

                                <th>
                                    Category
                                </th>

                                <th>
                                    Assigned To
                                </th>

                                <th>
                                    Priority
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Created
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            {filteredTickets.length === 0 ? (

                                <tr>

                                    <td
                                        colSpan="8"
                                        className="empty-tickets"
                                    >

                                        <div>

                                            <strong>
                                                No tickets found
                                            </strong>

                                            <span>
                                                Try changing your
                                                search or filters.
                                            </span>

                                        </div>

                                    </td>

                                </tr>

                            ) : (

                                filteredTickets.map(
                                    (ticket) => (

                                        <tr
                                            key={ticket.id}
                                            onClick={() =>
                                                openTicket(
                                                    ticket
                                                )
                                            }
                                            className="ticket-row"
                                        >

                                            <td>

                                                <span className="table-ticket-id">
                                                    #{ticket.id}
                                                </span>

                                            </td>


                                            <td>

                                                <div className="table-subject">

                                                    <strong>
                                                        {
                                                            ticket.ticket_title
                                                        }
                                                    </strong>

                                                    <span>
                                                        {ticket.description
                                                            ? ticket.description.slice(
                                                                0,
                                                                55
                                                            )
                                                            : "No description"}
                                                    </span>

                                                </div>

                                            </td>


                                            <td>
                                                {ticket.category ||
                                                    "General"}
                                            </td>


                                            <td>

                                                {ticket.assigned_agent_name ? (

                                                    <div className="table-owner">

                                                        <div className="mini-avatar">
                                                            {getInitials(
                                                                ticket.assigned_agent_name
                                                            )}
                                                        </div>

                                                        <div>

                                                            <strong>
                                                                {
                                                                    ticket.assigned_agent_name
                                                                }
                                                            </strong>

                                                            <small>
                                                                {
                                                                    ticket.assigned_agent_email
                                                                }
                                                            </small>

                                                        </div>

                                                    </div>

                                                ) : (

                                                    <span className="muted">
                                                        Unassigned
                                                    </span>

                                                )}

                                            </td>


                                            <td>

                                                <span
                                                    className={getPriorityClass(
                                                        ticket.priority
                                                    )}
                                                >
                                                    {ticket.priority ||
                                                        "Medium"}
                                                </span>

                                            </td>


                                            <td
                                                onClick={(e) =>
                                                    e.stopPropagation()
                                                }
                                            >

                                                <select
                                                    className="table-status-select"
                                                    value={
                                                        ticket.status ||
                                                        "Open"
                                                    }
                                                    onChange={(e) =>
                                                        updateTicket(
                                                            ticket,
                                                            {
                                                                status:
                                                                    e
                                                                        .target
                                                                        .value
                                                            }
                                                        )
                                                    }
                                                >

                                                    <option value="Open">
                                                        Open
                                                    </option>

                                                    <option value="In Progress">
                                                        In Progress
                                                    </option>

                                                    <option value="Resolved">
                                                        Resolved
                                                    </option>

                                                    <option value="Closed">
                                                        Closed
                                                    </option>

                                                </select>

                                            </td>


                                            <td>
                                                {formatDate(
                                                    ticket.created_at
                                                )}
                                            </td>


                                            <td
                                                onClick={(e) =>
                                                    e.stopPropagation()
                                                }
                                            >

                                                <button
                                                    className="view-ticket-button"
                                                    onClick={() =>
                                                        openTicket(
                                                            ticket
                                                        )
                                                    }
                                                >
                                                    View
                                                </button>

                                                <button
                                                    className="table-delete-button"
                                                    onClick={() =>
                                                        deleteTicket(
                                                            ticket.id
                                                        )
                                                    }
                                                >
                                                    Delete
                                                </button>

                                            </td>

                                        </tr>

                                    )
                                )

                            )}

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    );
}

export default ViewTicket;
